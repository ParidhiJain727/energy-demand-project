# PowerPlay Energy Demand Forecasting - Environment Variables
# Copy this file to .env and configure the variables for your local setup

# --------------------------
# Database Configuration
# --------------------------
# PostgreSQL connection string
# Example format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/powerplay

# --------------------------
# API Configuration
# --------------------------
# Host and port for the FastAPI server
API_HOST=0.0.0.0
API_PORT=8000

# --------------------------
# Streamlit Configuration
# --------------------------
# Host and port for the Streamlit dashboard
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501

# --------------------------
# AI/LLM Integration (Optional)
# --------------------------
# Add your API keys here if connecting the Power-Pulse Assistant to an external LLM
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
